extends Node
## Veilborne audio runtime (autoload "Audio").
## - Buses Master/Music/SFX/UI (created in code when the project has no bus layout for them).
## - Pooled voices: positional AudioStreamPlayer2D + non-positional AudioStreamPlayer, voice stealing by
##   priority then age, per-sound cooldown and per-sound instance cap (no machine-gun stacking).
## - Two music players with an equal-power crossfade, driven from _process (no tweens, no allocs).
## - Volumes persisted to user://settings.cfg [audio] master/music/sfx (other sections are preserved).
## - All streams are loaded once in _ready (music lazily on first use, then cached). Missing files warn
##   once and every call becomes a silent no-op; nothing here can crash the game.
## - Voice lines (Warden barks, narrator) on their own "Voice" bus: one line at a time, short cooldown,
##   music ducked while a line plays. Clips are listed in res://audio/voice/index.gd (generated by
##   audio/voice/build_voice.py); a missing clip is silent but voice() still returns the subtitle text.

const SFX_DIR := "res://audio/sfx/"
const MUSIC_DIR := "res://audio/music/"
const SETTINGS_PATH := "user://settings.cfg"
const VOICE_INDEX := "res://audio/voice/index.gd"
const VOICE_DB := 0.0           # clips are mastered to about -16 LUFS
const VOICE_DUCK_DB := -6.0     # music dip while a voice line plays
const VOICE_DUCK_ATTACK := 0.12 # seconds to dip
const VOICE_DUCK_RELEASE := 0.6 # seconds to recover
const VOICE_COOLDOWN_MS := 1200 # gap after a line ends (or is refused) before the next may start

const SFX_NAMES: PackedStringArray = [
	"swing_spear", "swing_blades", "hit_flesh", "hit_crit", "dash", "special_ember", "special_moon",
	"hero_hurt", "hero_down", "revive", "enemy_die", "shade_lunge", "spitter_shoot", "projectile_hit",
	"brute_slam", "slam_impact", "regent_burst", "regent_charge", "regent_summon", "regent_roar",
	"regent_die", "boon_pickup", "door_open", "room_clear", "shard_pickup", "footstep",
]
const UI_NAMES: PackedStringArray = ["click", "hover", "confirm", "back", "boon", "purchase", "open"]
## Music files in res://audio/music/<name>.ogg. Chapter tracks: catacombs (1), garden (2), forge (3), throne (4).
const MUSIC_FILES: PackedStringArray = [
	"title", "home", "catacombs", "garden", "forge", "throne", "boss_general", "boss_regent",
	"victory", "defeat",
]
## Legacy track names kept working: they play the file they map to.
const MUSIC_ALIASES := {"sanctum": "home", "boss": "boss_regent"}
## Every accepted track name (files + aliases).
const MUSIC_TRACKS: PackedStringArray = [
	"title", "home", "catacombs", "garden", "forge", "throne", "boss_general", "boss_regent",
	"victory", "defeat", "sanctum", "boss",
]
## Stings play once; everything else loops seamlessly.
const ONE_SHOT_TRACKS: PackedStringArray = ["victory", "defeat"]

## Per-sound tuning: [base volume dB, priority (higher survives stealing), cooldown ms, max simultaneous]
const TUNING := {
	"swing_spear": [-4.0, 3, 45, 3],
	"swing_blades": [-4.0, 3, 45, 3],
	"hit_flesh": [-2.0, 4, 40, 4],
	"hit_crit": [0.0, 6, 50, 2],
	"dash": [-4.0, 4, 80, 2],
	"special_ember": [0.0, 7, 150, 2],
	"special_moon": [0.0, 7, 150, 2],
	"hero_hurt": [-1.0, 8, 120, 2],
	"hero_down": [0.0, 9, 300, 2],
	"revive": [0.0, 9, 300, 2],
	"enemy_die": [-3.0, 5, 50, 3],
	"shade_lunge": [-6.0, 3, 90, 2],
	"spitter_shoot": [-6.0, 3, 70, 3],
	"projectile_hit": [-7.0, 2, 50, 3],
	"brute_slam": [-3.0, 5, 120, 2],
	"slam_impact": [-1.0, 6, 80, 2],
	"regent_burst": [-1.0, 8, 150, 1],
	"regent_charge": [0.0, 8, 300, 1],
	"regent_summon": [0.0, 8, 400, 1],
	"regent_roar": [0.0, 9, 500, 1],
	"regent_die": [0.0, 10, 1000, 1],
	"boon_pickup": [-2.0, 7, 150, 2],
	"door_open": [-2.0, 6, 500, 1],
	"room_clear": [-1.0, 8, 500, 1],
	"shard_pickup": [-6.0, 4, 40, 3],
	"footstep": [-16.0, 0, 90, 2],
	"ui_click": [-4.0, 5, 30, 2],
	"ui_hover": [-12.0, 1, 60, 1],
	"ui_confirm": [-3.0, 6, 60, 2],
	"ui_back": [-4.0, 6, 60, 2],
	"ui_boon": [-2.0, 7, 120, 2],
	"ui_purchase": [-2.0, 7, 80, 2],
	"ui_open": [-5.0, 5, 80, 2],
}
const DEFAULT_TUNING := [-3.0, 3, 40, 3]

const POS_VOICES := 16      # positional (AudioStreamPlayer2D)
const FLAT_VOICES := 8      # non-positional gameplay sfx
const UI_VOICES := 4
const MAX_DISTANCE := 2200.0
const MUSIC_DB := -4.0      # headroom for the music bed under sfx

var master_volume := 1.0
var music_volume := 0.7
var sfx_volume := 0.9
var voice_volume := 1.0

var _streams := {}          # name -> AudioStream (or null when missing)
var _music_streams := {}    # track -> AudioStream (or null)
var _warned := {}
var _last_play_ms := {}     # name -> msec
var _tuning_cache := {}     # name -> Array

# voice pools: parallel arrays avoid per-call allocation
var _pos_players: Array[AudioStreamPlayer2D] = []
var _flat_players: Array[AudioStreamPlayer] = []
var _ui_players: Array[AudioStreamPlayer] = []
var _pos_name: Array = []      # (Arrays are shared by reference when passed to _pick_voice)
var _pos_prio: Array = []
var _pos_start: Array = []
var _flat_name: Array = []
var _flat_prio: Array = []
var _flat_start: Array = []
var _ui_next := 0
var _ui_keys := {}             # "click" -> "ui_click" (prebuilt, no string concat per call)

# music
var _mus: Array[AudioStreamPlayer] = []
var _mus_active := 0
var _mus_track := ""
var _fade_t := 1.0
var _fade_len := 1.0
var _fading := false

var _bus_master := 0
var _bus_music := 0
var _bus_sfx := 0
var _bus_ui := 0
var _bus_voice := 0

# voice
var _voice_player: AudioStreamPlayer
var _voice_index := {}          # speaker -> context -> Array[String] (res paths, "" = not recorded)
var _voice_streams := {}        # path -> AudioStream (null when missing)
var _voice_free_ms := -100000   # earliest msec a new line may start
var _voice_text := ""
var _duck_db := 0.0             # current music offset (0 .. VOICE_DUCK_DB)


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_buses()
	_build_pools()
	_load_sfx()
	_load_voice_index()
	_load_settings()
	_apply_volumes()
	set_process(false)


# ---------------------------------------------------------------- public API

## Play a gameplay sfx. pos == Vector2.INF -> non-positional. Pooled; never allocates per call.
func sfx(name: String, pos := Vector2.INF, pitch_var := 0.08, volume_db := 0.0) -> void:
	_play(name, pos, pitch_var, volume_db, false)


## Play a UI sound: "click","hover","confirm","back","boon","purchase","open".
func ui(name: String) -> void:
	var key: String = _ui_keys.get(name, "")
	if key == "":
		_warn_once("ui:" + name, "Audio: unknown ui sound '%s'" % name)
		return
	_play(key, Vector2.INF, 0.03, 0.0, true)


## Switch music with a crossfade. "" (or unknown) stops music with a fade-out. Same track = no-op.
func music(track: String, fade := 1.0) -> void:
	if track != "" and _mus_track != "" and _mus.size() == 2 and _mus[_mus_active].playing \
			and _music_file(track) == _music_file(_mus_track):
		_mus_track = track  # e.g. "sanctum" -> "home": same file keeps playing, no restart
		return
	var stream: AudioStream = null
	if track != "":
		stream = _get_music(track)
	if _mus.size() < 2:
		return
	if _fading:  # a crossfade is in flight: drop the outgoing voice immediately
		_mus[1 - _mus_active].stop()
	var old := _mus[_mus_active]
	_mus_active = 1 - _mus_active
	var nxt := _mus[_mus_active]
	_mus_track = track if stream != null else ""
	nxt.stop()
	if stream != null:
		nxt.stream = stream
		nxt.volume_db = -80.0 if fade > 0.01 else MUSIC_DB
		nxt.play()
	if fade <= 0.01:
		old.stop()
		_fading = false
		set_process(false)
		if stream != null:
			nxt.volume_db = MUSIC_DB
		return
	_fade_len = fade
	_fade_t = 0.0
	_fading = true
	set_process(true)


## Linear 0..1 volumes; persisted to user://settings.cfg. voice_v < 0 keeps the current voice volume.
func set_volumes(master: float, music_v: float, sfx_v: float, voice_v := -1.0) -> void:
	master_volume = clampf(master, 0.0, 1.0)
	music_volume = clampf(music_v, 0.0, 1.0)
	sfx_volume = clampf(sfx_v, 0.0, 1.0)
	if voice_v >= 0.0:
		voice_volume = clampf(voice_v, 0.0, 1.0)
	_apply_volumes()
	_save_settings()


func get_volumes() -> Vector3:
	return Vector3(master_volume, music_volume, sfx_volume)


## Speak a voice line and return its text (for a subtitle).
## speaker: a Warden id ("oriel", "vessa", "mireth", "sable") -> Story.BARKS, or "narrator" -> Story.NARRATION.
## context: e.g. "greet", "low_health", "death_brute", "run_start". Unknown Warden contexts fall back to
## "greet"; unknown "death_*" contexts fall back to "death_enemy" (same rules as StoryDB).
## index: line number inside the context, -1 = random.
## Only one line plays at a time: while one is playing (or within VOICE_COOLDOWN_MS after it) the new
## line is not voiced, but its text is still returned. Returns "" only when the context has no lines.
func voice(speaker: String, context := "greet", index := -1) -> String:
	var lines := _voice_lines(speaker, context)
	if lines.is_empty():
		return ""
	var ctx: String = lines[0]
	var arr: Array = lines[1]
	var i := index if index >= 0 and index < arr.size() else randi() % arr.size()
	var text := String(arr[i])
	var now := Time.get_ticks_msec()
	if _voice_player == null or _voice_player.playing or now < _voice_free_ms:
		return text
	var stream := _voice_stream(speaker, ctx, i)
	if stream == null:
		return text
	_voice_text = text
	_voice_player.stream = stream
	_voice_player.volume_db = VOICE_DB
	_voice_player.play()
	# block new lines for the clip length plus the cooldown even if 'finished' is missed
	_voice_free_ms = now + int(stream.get_length() * 1000.0) + VOICE_COOLDOWN_MS
	set_process(true)
	return text


func is_voice_playing() -> bool:
	return _voice_player != null and _voice_player.playing


## Cut the current voice line (e.g. when a menu closes). The music un-ducks smoothly.
func stop_voice() -> void:
	if _voice_player:
		_voice_player.stop()
	_voice_free_ms = Time.get_ticks_msec() + VOICE_COOLDOWN_MS
	set_process(true)


## True when a clip exists for this line (tests / diagnostics).
func has_voice(speaker: String, context: String, index: int) -> bool:
	return _voice_stream(speaker, context, index) != null


func current_music() -> String:
	return _mus_track


func stop_all_sfx() -> void:
	for p in _pos_players:
		p.stop()
	for p in _flat_players:
		p.stop()


## Names of sounds/tracks whose files are missing (for tests/diagnostics).
func missing() -> PackedStringArray:
	var out := PackedStringArray()
	for k in _streams:
		if _streams[k] == null:
			out.append(k)
	for t in MUSIC_TRACKS:
		if _get_music(t) == null:
			out.append("music:" + t)
	return out


# ---------------------------------------------------------------- internals

func _ensure_buses() -> void:
	_bus_master = 0
	_bus_music = _ensure_bus("Music")
	_bus_sfx = _ensure_bus("SFX")
	_bus_ui = _ensure_bus("UI")
	_bus_voice = _ensure_bus("Voice")


func _ensure_bus(bus_name: String) -> int:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx == -1:
		AudioServer.add_bus()
		idx = AudioServer.bus_count - 1
		AudioServer.set_bus_name(idx, bus_name)
		AudioServer.set_bus_send(idx, "Master")
	return idx


func _build_pools() -> void:
	for i in POS_VOICES:
		var p := AudioStreamPlayer2D.new()
		p.bus = "SFX"
		p.max_distance = MAX_DISTANCE
		p.attenuation = 1.2
		p.panning_strength = 0.6
		p.max_polyphony = 1
		add_child(p)
		_pos_players.append(p)
	_pos_name.resize(POS_VOICES)
	_pos_name.fill("")
	_pos_prio.resize(POS_VOICES)
	_pos_prio.fill(0)
	_pos_start.resize(POS_VOICES)
	_pos_start.fill(0)
	for i in FLAT_VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_flat_players.append(p)
	_flat_name.resize(FLAT_VOICES)
	_flat_name.fill("")
	_flat_prio.resize(FLAT_VOICES)
	_flat_prio.fill(0)
	_flat_start.resize(FLAT_VOICES)
	_flat_start.fill(0)
	for i in UI_VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = "UI"
		add_child(p)
		_ui_players.append(p)
	_voice_player = AudioStreamPlayer.new()
	_voice_player.bus = "Voice"
	add_child(_voice_player)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.bus = "Music"
		m.volume_db = MUSIC_DB
		add_child(m)
		_mus.append(m)


func _load_sfx() -> void:
	for n in SFX_NAMES:
		_streams[n] = _load_stream(SFX_DIR + n)
		_last_play_ms[n] = -100000
		_tuning_cache[n] = TUNING.get(n, DEFAULT_TUNING)
	for n in UI_NAMES:
		var key := "ui_" + n
		_ui_keys[n] = key
		_streams[key] = _load_stream(SFX_DIR + key)
		_last_play_ms[key] = -100000
		_tuning_cache[key] = TUNING.get(key, DEFAULT_TUNING)


func _load_stream(base: String) -> AudioStream:
	for ext in [".wav", ".ogg", ".mp3"]:
		var path: String = base + ext
		if ResourceLoader.exists(path):
			var s = load(path)
			if s is AudioStream:
				return s
	_warn_once(base, "Audio: missing sound '%s' (.wav/.ogg) - calls will be silent" % base)
	return null


func _load_voice_index() -> void:
	if not ResourceLoader.exists(VOICE_INDEX):
		_warn_once("voice_index", "Audio: no voice index at %s - voice lines will be silent" % VOICE_INDEX)
		return
	var scr = load(VOICE_INDEX)
	if scr is Script:
		var consts: Dictionary = (scr as Script).get_script_constant_map()
		var v = consts.get("VOICE", {})
		if v is Dictionary:
			_voice_index = v


## [resolved context, lines] for a speaker/context, or [] when there are none.
func _voice_lines(speaker: String, context: String) -> Array:
	if speaker == "narrator":
		var ctx := context
		var arr: Array = Story.NARRATION.get(ctx, [])
		if arr.is_empty() and ctx.begins_with("death_"):
			ctx = "death_enemy"
			arr = Story.NARRATION.get(ctx, [])
		return [] if arr.is_empty() else [ctx, arr]
	var by_ctx: Dictionary = Story.BARKS.get(speaker, {})
	var c := context if by_ctx.has(context) else "greet"
	var lines: Array = by_ctx.get(c, [])
	return [] if lines.is_empty() else [c, lines]


func _voice_stream(speaker: String, context: String, index: int) -> AudioStream:
	var paths: Array = _voice_index.get(speaker, {}).get(context, [])
	if index < 0 or index >= paths.size():
		return null
	var path := String(paths[index])
	if path == "":
		return null
	if _voice_streams.has(path):
		return _voice_streams[path]
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		var r = load(path)
		if r is AudioStream:
			s = r
			if s is AudioStreamOggVorbis:
				(s as AudioStreamOggVorbis).loop = false
	if s == null:
		_warn_once(path, "Audio: missing voice clip '%s'" % path)
	_voice_streams[path] = s
	return s


## Resolves a track name (or legacy alias) to its file name; "" when unknown.
func _music_file(track: String) -> String:
	var f: String = MUSIC_ALIASES.get(track, track)
	return f if MUSIC_FILES.has(f) else ""


func _get_music(track: String) -> AudioStream:
	var file := _music_file(track)
	if file == "":
		_warn_once("track:" + track, "Audio: unknown music track '%s'" % track)
		return null
	if _music_streams.has(file):
		return _music_streams[file]
	var s: AudioStream = _load_stream(MUSIC_DIR + file)
	if s != null:
		var lp := not ONE_SHOT_TRACKS.has(file)
		if s is AudioStreamOggVorbis:
			(s as AudioStreamOggVorbis).loop = lp
			(s as AudioStreamOggVorbis).loop_offset = 0.0
		elif s is AudioStreamMP3:
			(s as AudioStreamMP3).loop = lp
	_music_streams[file] = s
	return s


func _warn_once(key: String, msg: String) -> void:
	if _warned.has(key):
		return
	_warned[key] = true
	push_warning(msg)


func _play(name: String, pos: Vector2, pitch_var: float, volume_db: float, is_ui: bool) -> void:
	var stream: AudioStream = _streams.get(name)
	if stream == null:
		if not _streams.has(name):
			_warn_once(name, "Audio: unknown sound '%s'" % name)
		return
	var now := Time.get_ticks_msec()
	var tune: Array = _tuning_cache[name]
	if now - int(_last_play_ms[name]) < int(tune[2]):
		return
	_last_play_ms[name] = now
	var vol: float = float(tune[0]) + volume_db
	var pitch := 1.0
	if pitch_var > 0.0:
		pitch = 1.0 + randf_range(-pitch_var, pitch_var)
	if is_ui:
		var up := _ui_players[_ui_next]
		_ui_next = (_ui_next + 1) % UI_VOICES
		up.stream = stream
		up.volume_db = vol
		up.pitch_scale = pitch
		up.play()
		return
	var prio: int = int(tune[1])
	var cap: int = int(tune[3])
	if pos == Vector2.INF:
		var i := _pick_voice(_flat_players, _flat_name, _flat_prio, _flat_start, name, prio, cap, now)
		if i < 0:
			return
		var p := _flat_players[i]
		p.stream = stream
		p.volume_db = vol
		p.pitch_scale = pitch
		p.play()
	else:
		var j := _pick_voice(_pos_players, _pos_name, _pos_prio, _pos_start, name, prio, cap, now)
		if j < 0:
			return
		var q := _pos_players[j]
		q.global_position = pos
		q.stream = stream
		q.volume_db = vol
		q.pitch_scale = pitch
		q.play()


## Returns a voice index or -1. Prefers a free voice; enforces the per-sound cap by recycling the
## oldest instance of the same sound; otherwise steals the lowest-priority (then oldest) voice whose
## priority is <= the new sound's.
func _pick_voice(players: Array, names: Array, prios: Array,
		starts: Array, name: String, prio: int, cap: int, now: int) -> int:
	var free_i := -1
	var same_count := 0
	var same_oldest := -1
	var steal_i := -1
	var steal_prio := 1 << 30
	var steal_start := 1 << 62
	for i in players.size():
		var pl = players[i]
		if not pl.playing:
			if free_i < 0:
				free_i = i
			continue
		if names[i] == name:
			same_count += 1
			if same_oldest < 0 or int(starts[i]) < int(starts[same_oldest]):
				same_oldest = i
		var pr: int = prios[i]
		var st: int = starts[i]
		if pr < steal_prio or (pr == steal_prio and st < steal_start):
			steal_prio = pr
			steal_start = st
			steal_i = i
	var chosen := -1
	if same_count >= cap and same_oldest >= 0:
		chosen = same_oldest
	elif free_i >= 0:
		chosen = free_i
	elif steal_i >= 0 and steal_prio <= prio:
		chosen = steal_i
	if chosen < 0:
		return -1
	players[chosen].stop()
	names[chosen] = name
	prios[chosen] = prio
	starts[chosen] = now
	return chosen


func _process(delta: float) -> void:
	var ducking := _update_duck(delta)
	if not _fading:
		if not ducking:
			set_process(false)
		return
	_fade_t = minf(_fade_t + delta / maxf(_fade_len, 0.001), 1.0)
	var a := _mus[_mus_active]
	var b := _mus[1 - _mus_active]
	# equal-power crossfade
	var gin := sin(_fade_t * PI * 0.5)
	var gout := cos(_fade_t * PI * 0.5)
	if a.playing:
		a.volume_db = MUSIC_DB + linear_to_db(maxf(gin, 0.0001))
	if b.playing:
		b.volume_db = MUSIC_DB + linear_to_db(maxf(gout, 0.0001))
	if _fade_t >= 1.0:
		b.stop()
		if a.playing:
			a.volume_db = MUSIC_DB
		_fading = false
		if not ducking:
			set_process(false)


## Moves the music duck toward its target. Returns true while it still needs processing.
func _update_duck(delta: float) -> bool:
	var talking := _voice_player != null and _voice_player.playing
	var target := VOICE_DUCK_DB if talking else 0.0
	if not is_equal_approx(_duck_db, target):
		var rate := absf(VOICE_DUCK_DB) / (VOICE_DUCK_ATTACK if talking else VOICE_DUCK_RELEASE)
		_duck_db = move_toward(_duck_db, target, rate * delta)
		_set_bus_linear(_bus_music, music_volume, _duck_db)
	return talking or not is_equal_approx(_duck_db, 0.0)


func _apply_volumes() -> void:
	_set_bus_linear(_bus_master, master_volume)
	_set_bus_linear(_bus_music, music_volume, _duck_db)
	_set_bus_linear(_bus_sfx, sfx_volume)
	_set_bus_linear(_bus_ui, sfx_volume)
	_set_bus_linear(_bus_voice, voice_volume)


func _set_bus_linear(idx: int, v: float, offset_db := 0.0) -> void:
	if idx < 0 or idx >= AudioServer.bus_count:
		return
	AudioServer.set_bus_mute(idx, v <= 0.001)
	AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(v, 0.001)) + offset_db)


func _load_settings() -> void:
	var cf := ConfigFile.new()
	if cf.load(SETTINGS_PATH) != OK:
		return
	master_volume = clampf(float(cf.get_value("audio", "master", master_volume)), 0.0, 1.0)
	music_volume = clampf(float(cf.get_value("audio", "music", music_volume)), 0.0, 1.0)
	sfx_volume = clampf(float(cf.get_value("audio", "sfx", sfx_volume)), 0.0, 1.0)
	voice_volume = clampf(float(cf.get_value("audio", "voice", voice_volume)), 0.0, 1.0)


func _save_settings() -> void:
	var cf := ConfigFile.new()
	cf.load(SETTINGS_PATH)  # keep other sections (ok if missing)
	cf.set_value("audio", "master", master_volume)
	cf.set_value("audio", "music", music_volume)
	cf.set_value("audio", "sfx", sfx_volume)
	cf.set_value("audio", "voice", voice_volume)
	var err := cf.save(SETTINGS_PATH)
	if err != OK:
		_warn_once("settings_save", "Audio: could not save %s (%d)" % [SETTINGS_PATH, err])


func _exit_tree() -> void:
	# stop every voice so no playback keeps streams alive at shutdown
	stop_all_sfx()
	if _voice_player:
		_voice_player.stop()
		_voice_player.stream = null
	_voice_streams.clear()
	for p in _ui_players:
		p.stop()
	for m in _mus:
		m.stop()
		m.stream = null
	_music_streams.clear()
